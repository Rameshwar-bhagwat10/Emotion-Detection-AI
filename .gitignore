# Logs
*.log
logs/

# Datasets (Do not commit large raw datasets)
data/raw/*
data/interim/*
data/processed/*

# Models & Checkpoints (Do not commit binary weights)
models/checkpoints/*
models/experiments/*
models/production/*

# Preserve .gitkeep and documentation files
!.gitkeep
!data/**/README.md
!models/**/README.md

# ML Binary Weights & Artifacts
*.pt
*.pth
*.onnx
*.h5
*.keras
*.tflite
*.joblib
*.pkl

