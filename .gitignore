# Environment Variables
.env
.env.*
!.env.example
!.env.local.example

# Node / Frontend
node_modules/
.next/
out/
dist/
coverage/
.npm/

# Python Virtual Environments & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
ENV/
env/
*.egg-info/
htmlcov/
