# Environment Variables
.env
.env.*
!.env.example
!.env.local.example

# Node / Frontend
node_modules/
.next/
out/
dist/
coverage/
.npm/

# Python Virtual Environments & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
ENV/
env/
*.egg-info/
htmlcov/
.coverage

# Logs
*.log
logs/

# Datasets (Do not commit large raw datasets)
data/raw/*
data/interim/*
data/processed/*

# Models, Artifacts & Checkpoints (Do not commit binary weights/runs)
artifacts/training/*
!artifacts/training/.gitkeep
models/checkpoints/*
models/experiments/*
models/production/*

# Preserve .gitkeep and documentation files
!.gitkeep
!artifacts/**/.gitkeep
!data/**/README.md
!models/**/README.md

# ML Binary Weights & Artifacts
*.pt
*.pth
*.onnx
*.h5
*.keras
*.tflite
*.joblib
*.data

# Whitelist production champion model and face detector
!artifacts/optimized/champion/model.pt
!ml/inference/assets/face_detection_yunet.onnx

# Ignore backups & temporary crops
*.bak
data/sample_crops/
data/sample_crops_exact/
data/user_eval_crops/
*.db-shm
*.db-wal

# Databases & Local Upload Storage
*.db
*.sqlite
*.sqlite3
apps/api/storage/*
!apps/api/storage/.gitkeep
storage/*
!storage/.gitkeep


# IDEs & Operating System
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*.tsbuildinfo
scratch/
